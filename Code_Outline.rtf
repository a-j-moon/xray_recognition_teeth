 \
 \cf4 \strokec4 # loop over epochs\cf6 \strokec6 \
 \cf11 \cb5 \strokec11 print\cf6 \cb5 \strokec6 (\cf8 \strokec8 "[INFO] training the network..."\cf6 \strokec6 )\
 startTime = time.time()\

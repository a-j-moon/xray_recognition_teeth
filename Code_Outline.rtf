   \cf10 \cb5 \strokec10 if\cf6 \cb5 \strokec6  (i + \cf9 \strokec9 2\cf6 \strokec6 ) % \cf9 \strokec9 2\cf6 \strokec6  == \cf9 \strokec9 0\cf6 \strokec6 :\
    opt.step()\
    opt.zero_grad()\
   \cf4 \strokec4 # add the loss to the total training loss so far and\cf6 \strokec6 \
   \cf4 \strokec4 # calculate the number of correct predictions\cf6 \strokec6 \
   totalTrainLoss += loss\
   trainCorrect += (pred.argmax(\cf9 \strokec9 1\cf6 \strokec6 ) == y).\cf11 \cb5 \strokec11 type\cf6 \cb5 \strokec6 (torch.\cf11 \cb5 \strokec11 float\cf6 \cb5 \strokec6 ).\cf11 \cb5 \strokec11 sum\cf6 \cb5 \strokec6 ().item()\
   loop_endTime = time.time()\
   \cf4 \strokec4 # print("Loop %s finished in:\{\} seconds", (format(loop_endTime - loop_startTime), str(i)))\cf6 \strokec6 \
  \cf4 \strokec4 # switch off autograd\cf6 \strokec6 \
  \cf10 \cb5 \strokec10 with\cf6 \cb5 \strokec6  torch.no_grad():\

  trainCorrect = trainCorrect / \cf11 \cb5 \strokec11 len\cf6 \cb5 \strokec6 (trainDS)\
  valCorrect = valCorrect / \cf11 \cb5 \strokec11 len\cf6 \cb5 \strokec6 (valDS)\
  \cf4 \strokec4 # update our training history\cf6 \strokec6 \
  H[\cf8 \strokec8 "train_loss"\cf6 \strokec6 ].append(avgTrainLoss.cpu().detach().numpy())\
  H[\cf8 \strokec8 "train_acc"\cf6 \strokec6 ].append(trainCorrect)\

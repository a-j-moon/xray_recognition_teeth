\cf7 \strokec7 MEAN\cf6 \strokec6  = [\cf9 \strokec9 0.485\cf6 \strokec6 , \cf9 \strokec9 0.456\cf6 \strokec6 , \cf9 \strokec9 0.406\cf6 \strokec6 ]\
\cf7 \strokec7 STD\cf6 \strokec6  = [\cf9 \strokec9 0.229\cf6 \strokec6 , \cf9 \strokec9 0.224\cf6 \strokec6 , \cf9 \strokec9 0.225\cf6 \strokec6 ]\

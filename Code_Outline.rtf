   \cf10 \cb5 \strokec10 for\cf6 \cb5 \strokec6  (x, y) \cf10 \cb5 \strokec10 in\cf6 \cb5 \strokec6  valLoader:\
    \cf4 \strokec4 # send the input to the device\cf6 \strokec6 \
    (x, y) = (x.to(DEVICE), y.to(DEVICE))\
    \cf4 \strokec4 # make the predictions and calculate the validation loss\cf6 \strokec6 \
    pred = model(x)\
    totalValLoss += lossFunc(pred, y)\
    \cf4 \strokec4 # calculate the number of correct predictions\cf6 \strokec6 \
    valCorrect += (pred.argmax(\cf9 \strokec9 1\cf6 \strokec6 ) == y).\cf11 \cb5 \strokec11 type\cf6 \cb5 \strokec6 (torch.\cf11 \cb5 \strokec11 float\cf6 \cb5 \strokec6 ).\cf11 \cb5 \strokec11 sum\cf6 \cb5 \strokec6 ().item()\
\
# Section 5 - Training and validation loss\
\
  \cf4 \strokec4 # calculate the average training and validation loss\cf6 \strokec6 \
  avgTrainLoss = totalTrainLoss / trainSteps\
  avgValLoss = totalValLoss / valSteps\

\
# Section 3 - Defining the base model efficientnet_b0\
\
\pard\pardeftab720\partightenfactor0
\cf4 \strokec4 # defining efficientnet_b0 model\cf6 \strokec6 \
model = efficientnet_b0(pretrained=True)\
\cf4 \strokec4 # setting its parameters to non-trainable (by default they are trainable)\cf6 \strokec6 \
for param in model.parameters():\
param.requires_grad = False\
\cf4 \strokec4 # Building on top of the base efficientnet_b0 model\cf6 \strokec6 \
model.classifier[1] = nn.Sequential(nn.Linear(in_features=1280, out_features=len(number of classes you have in your dataset)), nn.Softmax(dim=1))\
\cf4 \strokec4 # transfer model to cuda if available.\cf6 \strokec6 \
model = model.to(DEVICE)\
\
\cf4 \strokec4 # initialize loss function and optimizer (notice that we are only\cf6 \strokec6 \
\cf4 \strokec4 # providing the parameters of the classification top to our optimizer)\cf6 \strokec6 \
lossFunc = nn.CrossEntropyLoss()\

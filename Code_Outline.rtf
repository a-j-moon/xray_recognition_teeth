 \cf10 \cb5 \strokec10 return\cf6 \cb5 \strokec6  (ds, loader)\
\
\pard\pardeftab720\partightenfactor0
\cf4 \strokec4 # calling the function to load the training dataset\cf6 \strokec6 \
(trainDS, trainLoader) = get_dataloader(TRAIN_DATASET_PATH, transforms=trainTransform,\

 \cf10 \cb5 \strokec10 for\cf6 \cb5 \strokec6  e \cf10 \cb5 \strokec10 in\cf6 \cb5 \strokec6  tqdm(\cf11 \cb5 \strokec11 range\cf6 \cb5 \strokec6 (EPOCHS)):\
  epoch_startTime = time.time()\
  \cf4 \strokec4 # set the model in training mode\cf6 \strokec6 \
  model.train()\
  \cf4 \strokec4 # initialize the total training and validation loss\cf6 \strokec6 \
  totalTrainLoss = \cf9 \strokec9 0\cf6 \strokec6 \
  totalValLoss = \cf9 \strokec9 0\cf6 \strokec6 \
  \cf4 \strokec4 # initialize the number of correct predictions in the training and validation step\cf6 \strokec6 \
  trainCorrect = \cf9 \strokec9 0\cf6 \strokec6 \
  valCorrect = \cf9 \strokec9 0\cf6 \strokec6 \
  \cf4 \strokec4 # loop over the training set\cf6 \strokec6 \
  \cf10 \cb5 \strokec10 for\cf6 \cb5 \strokec6  (i, (x, y)) \cf10 \cb5 \strokec10 in\cf6 \cb5 \strokec6  \cf11 \cb5 \strokec11 enumerate\cf6 \cb5 \strokec6 (trainLoader):\
   loop_startTime = time.time()\

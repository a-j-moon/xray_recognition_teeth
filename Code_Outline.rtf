  \cf11 \cb5 \strokec11 print\cf6 \cb5 \strokec6 (\cf8 \strokec8 "Train loss: \{:.6f\}, Train accuracy: \{:.4f\}"\cf6 \strokec6 .\cf11 \cb5 \strokec11 format\cf6 \cb5 \strokec6 (avgTrainLoss, trainCorrect))\
  \cf11 \cb5 \strokec11 print\cf6 \cb5 \strokec6 (\cf8 \strokec8 "Val loss: \{:.6f\}, Val accuracy: \{:.4f\}"\cf6 \strokec6 .\cf11 \cb5 \strokec11 format\cf6 \cb5 \strokec6 (avgValLoss, valCorrect))\
  epoch_endTime = time.time()\

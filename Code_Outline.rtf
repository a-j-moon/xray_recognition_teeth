\
# Section 2 - Apply transformation\
\
\pard\pardeftab720\partightenfactor0
\cf10 \cb5 \strokec10 def\cf6 \cb5 \strokec6  get_dataloader(\cf11 \cb5 \strokec11 rootDir, transforms, batchSize, shuffle\cf6 \cb5 \strokec6 ):\
 \cf4 \strokec4 # create a dataset and use it to create a data loader\cf6 \strokec6 \
 ds = datasets.ImageFolder(root=rootDir,transform=transforms)\

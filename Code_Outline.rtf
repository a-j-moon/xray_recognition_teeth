   (x, y) = (x.to(DEVICE), y.to(DEVICE))\
   \cf4 \strokec4 # perform a forward pass and calculate the training loss\cf6 \strokec6 \
   pred = model(x)\
   loss = lossFunc(pred, y)\
   \cf4 \strokec4 # calculate the gradients\cf6 \strokec6 \
   loss.backward()\
   \cf4 \strokec4 # check if we are updating the model parameters and if so update them,\cf6 \strokec6 \

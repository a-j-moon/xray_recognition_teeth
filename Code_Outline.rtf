\
# Section 4 - Training the model\
\
\cf4 \strokec4 # calculate steps per epoch for training and validation set\cf6 \strokec6 \
 trainSteps = \cf11 \cb5 \strokec11 len\cf6 \cb5 \strokec6 (trainDS) // FEATURE_EXTRACTION_BATCH_SIZE\
